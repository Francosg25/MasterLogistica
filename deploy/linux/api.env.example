# Copy through configure.py; keep the resulting api.env outside Git, mode 0640.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://masterlogistica_app:CHANGE_ME@db.example.invalid:5432/masterlogistica?sslmode=verify-full&sslrootcert=/etc/masterlogistica/postgres-ca.pem
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_FRONTEND_CLIENT_ID=
ENTRA_ALLOWED_CLIENT_IDS=[]
ENTRA_REQUIRED_SCOPE=access_as_user
COMPANY_CODES=["JE_MX"]
BUSINESS_UNITS={}
ALLOWED_HOSTS=["@DOMAIN@"]
ALLOWED_ORIGINS=["https://@DOMAIN@"]
ENFORCE_HTTPS=true
TRUSTED_PROXY_IPS=["127.0.0.1"]
# Optional additional corporate CA for the HTTPS connection to Entra; TLS remains verified.
ENTRA_CA_BUNDLE=
