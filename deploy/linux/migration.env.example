# Separate OS account and PostgreSQL migration role. Never pass this file to the API.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://masterlogistica_migrator:CHANGE_ME@db.example.invalid:5432/masterlogistica?sslmode=verify-full&sslrootcert=/etc/masterlogistica/postgres-ca.pem
ENTRA_TENANT_ID=
