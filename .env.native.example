# Optional local settings. The launcher works without this file.
# Default database: .data/masterlogistica.db in the project root, created on first start.
APP_ENV=development
AUTH_MODE=development
COMPANY_CODES=["LOCAL"]
BUSINESS_UNITS={"M01":"M01","M19":"M19","M23":"M23","M45":"M45","M46":"M46"}
# Optional absolute file path; omit DATABASE_URL to use the default above.
# Windows example: sqlite+pysqlite:///C:/MasterLogistica-data/masterlogistica.db
# Linux example: sqlite+pysqlite:////home/usuario/MasterLogistica-data/masterlogistica.db
# This profile is for one computer. Production uses PostgreSQL and Entra.
