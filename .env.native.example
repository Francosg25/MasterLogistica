# Native local development only. Copy to .env.native and fill approved values.
# Without .env.native, INICIAR_LOCAL.cmd opens the read-only demo with no database.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://masterlogistica_app:PASSWORD@HOST:5432/DEVELOPMENT_DATABASE
# Optional: leave blank when the DBA has already applied the migrations.
# Never point these settings at an operational database for local testing.
MIGRATION_DATABASE_URL=
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_FRONTEND_CLIENT_ID=
ENTRA_ALLOWED_CLIENT_IDS=[]
COMPANY_CODES=["JE_MX"]
BUSINESS_UNITS={}
